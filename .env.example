# ── Site ──────────────────────────────────────────────────────────────────
# Base URL used for absolute canonical/OG URLs, JSON-LD and the sitemap.
# REQUIRED in production — replace with the real live domain before deploying.
# Never leave this pointing at localhost or the .example placeholder in prod.
NEXT_PUBLIC_SITE_URL=https://www.raretutorial.example

# ── Contact details ─────────────────────────────────────────────────────────
# Kept out of components (see config/contact.ts) so they can be updated here
# without touching code. These are public — they appear in tel:/mailto:/wa.me
# links rendered to every visitor.
NEXT_PUBLIC_CONTACT_PHONE_PRIMARY=+919830228998
NEXT_PUBLIC_CONTACT_PHONE_SECONDARY=+918335051385
NEXT_PUBLIC_CONTACT_WHATSAPP=+919830228998
NEXT_PUBLIC_CONTACT_EMAIL=raretutorialhome@gmail.com

# ── Enquiry form email delivery (server-only — never exposed to the client) ─
# Recipient for enquiry notifications. Falls back to NEXT_PUBLIC_CONTACT_EMAIL
# if unset.
CONTACT_FORM_RECIPIENT_EMAIL=raretutorialhome@gmail.com

# API key for the email provider used by lib/email/sendEmail.ts. Without this
# set, submissions are validated and logged but no email is actually sent —
# safe for local development, but REQUIRED before going live.
# Default provider wired up is Resend (https://resend.com); swap the fetch
# call in lib/email/sendEmail.ts to use SES/SendGrid/Mailgun instead if
# preferred — callers don't need to change.
EMAIL_PROVIDER_API_KEY=

# Verified sender identity for your email provider, e.g.:
#   RARE Tutorial Website <no-reply@yourdomain.com>
# Must be a domain/address verified with your email provider, or delivery
# will be rejected. Never derived from user input.
EMAIL_FROM=

# Signs the double opt-in confirmation link (see lib/email/confirmationToken.ts
# and app/api/contact/confirm/route.ts) — when a visitor gives an email
# address, they must click a confirmation link before RARE is notified, which
# filters out both bots and casual/uninterested submissions. REQUIRED once
# any visitor might supply an email (i.e. required for production — the field
# is optional on the form). Generate a random 32+ byte value, e.g.:
#   openssl rand -hex 32
# Changing this value invalidates any confirmation links already sent out.
CONFIRMATION_TOKEN_SECRET=

# ── Bot verification (Cloudflare Turnstile) — optional, recommended for prod ─
# Leave both blank to skip verification entirely (the form still has
# honeypot + timing + rate-limit protection without it). Get a free site key
# at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# Leave blank until a provider is chosen (see lib/analytics/trackEvent.ts).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
